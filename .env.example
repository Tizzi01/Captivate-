# Copy this file to .env.local and paste your key in.
# .env.local is gitignored — it never leaves your machine.
#
# Get a key: console.cloud.google.com -> new project -> APIs & Services ->
# Library -> "YouTube Data API v3" -> Enable -> Credentials -> Create API key.
# Then edit the key and set API restrictions -> YouTube Data API v3.
#
# This is a server-only variable. It is NOT prefixed with NEXT_PUBLIC_, so
# Next.js will never include it in the browser bundle.
YOUTUBE_API_KEY=

# Powers the "chat with me" bot on the landing page. FREE — no card needed.
# Get one at aistudio.google.com/apikey (sign in -> Create API key).
#
# Free tier has a daily request cap. When it runs out the chat says so politely
# and works again the next day. You are never billed.
#
# Server-only, like the YouTube key — never sent to the browser.
GEMINI_API_KEY=

# Optional. Mirrors chatbot conversations into a Discord channel so you can
# read them. Leave blank and nothing is logged or stored anywhere.
# Discord -> channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook
# Treat this like a password: anyone with it can post to that channel.
DISCORD_WEBHOOK_URL=

# Gates /scripts entirely, and the channel names, logos and links on /network.
# Anyone without it sees a locked page and nothing else: the protected content
# is never sent to the browser, so it cannot be dug out of the page source.
SITE_UNLOCK_PASSWORD=

# Signs the unlock cookie so it cannot be forged. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SITE_UNLOCK_SECRET=
